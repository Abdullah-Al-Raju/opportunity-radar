---
interface Props {
  deadline?: string;
  funding?: string;
  level?: string;
  location?: string;
  highlights?: string[];
}

const {
  deadline,
  funding,
  level,
  location,
  highlights = [],
} = Astro.props;
---

<div class="my-6 p-5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/80 shadow-xs">
  <div class="flex items-center gap-2 mb-3">
    <i class="fas fa-bolt text-amber-500 text-sm"></i>
    <h3 class="text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-slate-100">
      Quick Opportunity Snapshot (TL;DR)
    </h3>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-3 text-xs">
    {funding && (
      <div class="p-2.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-750">
        <span class="block text-[10px] text-slate-400 font-semibold uppercase tracking-wider">Funding</span>
        <span class="font-bold text-emerald-600 dark:text-emerald-400">{funding}</span>
      </div>
    )}
    {deadline && (
      <div class="p-2.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-750">
        <span class="block text-[10px] text-slate-400 font-semibold uppercase tracking-wider">Deadline</span>
        <span class="font-bold text-rose-600 dark:text-rose-400">{deadline}</span>
      </div>
    )}
    {level && (
      <div class="p-2.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-750">
        <span class="block text-[10px] text-slate-400 font-semibold uppercase tracking-wider">Level / Scope</span>
        <span class="font-bold text-indigo-600 dark:text-indigo-400">{level}</span>
      </div>
    )}
    {location && (
      <div class="p-2.5 rounded-xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-750">
        <span class="block text-[10px] text-slate-400 font-semibold uppercase tracking-wider">Location</span>
        <span class="font-bold text-slate-700 dark:text-slate-200">{location}</span>
      </div>
    )}
  </div>

  {highlights && highlights.length > 0 && (
    <ul class="space-y-1.5 text-xs text-slate-700 dark:text-slate-300">
      {highlights.map((item) => (
        <li class="flex items-start gap-2">
          <i class="fas fa-check text-indigo-500 mt-0.5 text-[10px]"></i>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  )}
</div>
